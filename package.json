{
  "name": "messaging-app",
  "version": "1.0.0",
  "description": "messaging app",
  "scripts": {
    "dev:api": "npm run dev --workspace @messaging-app/api",
    "dev:web": "npm run dev --workspace @messaging-app/web",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint apps packages eslint.config.js",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:watch": "npm run test:watch --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/STORM533/messaging-app.git"
  },
  "keywords": [],
  "type": "module",
  "bugs": {
    "url": "https://github.com/STORM533/messaging-app/issues"
  },
  "homepage": "https://github.com/STORM533/messaging-app#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  },
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/shared-types"
  ],
  "engines": {
    "node": ">=24 <25"
  }
